# Configure Reachy Mini Audio to use dmix for sharing
pcm.reachy_dmix {
    type dmix
    ipc_key 1024
    slave {
        pcm "hw:3,0"
        rate 48000
        channels 2
    }
}

pcm.reachy_dsnoop {
    type dsnoop
    ipc_key 1025
    slave {
        pcm "hw:3,0"
        rate 16000
        channels 6
    }
}

# Set as default
pcm.!default {
    type plug
    slave.pcm "reachy_dmix"
}

ctl.!default {
    type hw
    card 3
}
