[Unit]
Description=Start Reachy Mini Conversation App
After=reachy-mini-daemon.service
Requires=reachy-mini-daemon.service

[Service]
Type=oneshot
User=reachy
Group=reachy
ExecStart=/home/reachy/start-conversation-app.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
